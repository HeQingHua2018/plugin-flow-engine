{
  "name": "logic-engine",
  "version": "1.0.0",
  "private": true,
  "description": "规则引擎库",
  "keywords": [
    "plugin",
    "logic",
    "flow",
    "engine"
  ],
  "homepage": "https://flow.chloehe.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeQingHua2018/plugin-flow-engine"
  },
  "author": "HeQingHua",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter '@chloehe/*' --parallel run dev",
    "dev:doc": "pnpm --filter @chloehe/logic-engine-doc --parallel run dev",
    "build": "pnpm --filter '@chloehe/*' run build",
    "clean": "pnpm --filter '@chloehe/*' run clean && rimraf node_modules pnpm-lock.yaml packages/*/node_modules",
    "changelog": "node scripts/generate-changelog.js",
    "format": "prettier --write ./**/*.{js,jsx,ts,tsx,css,less,json,md}",
    "lint:eslint": "eslint --ext .js,.jsx,.ts,.tsx --fix --quiet ./",
    "lint:stylelint": "stylelint --fix ./**/*.less",
    "commit": "cz",
    "prepare": "husky",
    "test": "pnpm --filter \"@chloehe/*\" run test",
    "version:bump": "node scripts/bump-version.js"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/node": "^24.9.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/lodash": "^4.17.20",
    "@umijs/lint": "^4.0.0",
    "@xyflow/react": "^12.9.0",
    "antd": "^5.27.6",
    "babel-plugin-import": "^1.13.8",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-plugin-transform-remove-debugger": "^6.9.4",
    "conventional-changelog-angular": "^8.0.0",
    "conventional-changelog-cli": "^5.0.0",
    "cz-customizable": "^7.4.0",
    "dumi": "^2.4.13",
    "eslint": "^8.23.0",
    "father": "^4.1.0",
    "husky": "^8.0.1",
    "less": "^3.13.1",
    "lint-staged": "^13.0.3",
    "lodash": "^4.17.21",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rimraf": "^5.0.0",
    "stylelint": "^14.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.0",
    "tslib": "^2.6.0"
  },
  "engines": {
    "node": ">=18.20.4",
    "npm": ">=10.7.0",
    "pnpm": ">=10.18.2"
  },
  "packageManager": "pnpm@10.18.2",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}